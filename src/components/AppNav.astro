---
// Dedicated Webapp Navigation: Desktop Sidebar with Interactive Profile Dropdown + Mobile 3-Tab Bar + Mobile Header Profile Button
const pathname = Astro.url.pathname;
const user = Astro.locals.user;

const desktopNavItems = [
	{
		href: '/app/overview',
		exact: true,
		label: 'Overview',
		shortLabel: 'Hub',
		icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>`,
	},
	{
		href: '/app/neon-api',
		exact: false,
		label: 'Neon Data API',
		shortLabel: 'Neon API',
		icon: `<svg class="w-4 h-4 text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
	},
	{
		href: '/app/weather',
		exact: false,
		label: 'Weather (SSR)',
		shortLabel: 'Weather',
		icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>`,
	},
	{
		href: '/app/todos',
		exact: false,
		label: 'Todos (KV)',
		shortLabel: 'Todos',
		icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>`,
	},
	{
		href: '/app/search',
		exact: false,
		label: 'Search (CDN)',
		shortLabel: 'Search',
		icon: `<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>`,
	},
];

// Mobile bottom bar items: Streamlined to EXACTLY 3 main primary buttons (Hub, Weather, Todos)
const mobileBottomNavItems = [
	desktopNavItems[0]!,
	desktopNavItems[2]!,
	desktopNavItems[3]!,
];

function isItemActive(item: typeof desktopNavItems[0]) {
	if (item.exact) {
		return pathname === item.href;
	}
	return pathname.startsWith(item.href);
}

const isSubRoute = pathname !== '/app/overview';
const isSearchPage = pathname.startsWith('/app/search');
const isProfilePage = pathname.startsWith('/app/profile');
---

{/* DESKTOP APP SHELL SIDEBAR (md:flex) */}
<aside class="hidden md:flex flex-col w-60 shrink-0 border-r border-zinc-800 bg-zinc-950 p-4 h-full overflow-y-auto z-30 select-none relative">
	{/* Sidebar Header */}
	<div class="flex items-center gap-2.5 pb-4 border-b border-zinc-800/80 shrink-0">
		<div class="flex h-7 w-7 items-center justify-center rounded-md bg-zinc-100 font-mono text-xs font-bold text-zinc-950">
			v7
		</div>
		<div class="flex flex-col">
			<span class="text-xs font-semibold text-white tracking-tight">Webapp Shell</span>
			<span class="text-[10px] text-zinc-400 font-mono">Cloudflare + Neon</span>
		</div>
	</div>

	{/* Sidebar Section: Modules */}
	<div class="mt-5 flex-1">
		<p class="px-2 text-[10px] font-semibold uppercase tracking-wider text-zinc-500 font-mono">Modules</p>
		<nav class="mt-2 space-y-1">
			{
				desktopNavItems.map((item) => {
					const active = isItemActive(item);
					return (
						<a
							href={item.href}
							class={
								active
									? 'flex items-center gap-2.5 rounded-lg bg-zinc-800 px-3 py-2 text-xs font-medium text-white transition'
									: 'flex items-center gap-2.5 rounded-lg px-3 py-2 text-xs font-medium text-zinc-400 hover:bg-zinc-900 hover:text-zinc-200 transition'
							}
						>
							<Fragment set:html={item.icon} />
							<span>{item.label}</span>
						</a>
					);
				})
			}
		</nav>
	</div>

	{/* Sidebar Footer: Profile Trigger Button & Floating Dropdown */}
	<div class="mt-auto pt-4 border-t border-zinc-800/80 shrink-0 relative">
		{/* Floating Profile Dropdown Menu (Pops up above user card) */}
		<div
			id="profile-dropdown-menu"
			class="hidden absolute bottom-16 left-0 right-0 rounded-2xl border border-zinc-800 bg-zinc-900/95 p-1.5 backdrop-blur-xl shadow-2xl z-50 divide-y divide-zinc-800/80 text-xs font-medium"
		>
			<div class="p-2.5">
				<p class="font-semibold text-white truncate">{user?.name || 'Astro Developer'}</p>
				<p class="text-[10px] text-zinc-400 font-mono truncate">{user?.email || 'dev@astrov7.community'}</p>
			</div>

			<div class="py-1 space-y-0.5">
				<a
					href="/app/profile"
					class="flex items-center gap-2.5 rounded-xl px-2.5 py-2 text-zinc-300 hover:bg-zinc-800 hover:text-white transition"
				>
					<svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
					</svg>
					<span>Profile Saya</span>
				</a>
				<a
					href="/app/settings"
					class="flex items-center gap-2.5 rounded-xl px-2.5 py-2 text-zinc-300 hover:bg-zinc-800 hover:text-white transition"
				>
					<svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
					</svg>
					<span>Pengaturan (RBAC / ABAC)</span>
				</a>
				<a
					href="/"
					class="flex items-center gap-2.5 rounded-xl px-2.5 py-2 text-zinc-400 hover:bg-zinc-800 hover:text-white transition"
				>
					<svg class="w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
					</svg>
					<span>Kembali ke Website</span>
				</a>
			</div>

			<div class="pt-1">
				<a
					href="/api/auth/signout"
					class="flex items-center gap-2.5 rounded-xl px-2.5 py-2 text-rose-400 hover:bg-rose-500/10 transition"
				>
					<svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
					</svg>
					<span>Keluar / Sign Out</span>
				</a>
			</div>
		</div>

		{/* User Profile Card Button Trigger */}
		<button
			type="button"
			id="profile-dropdown-btn"
			aria-label="Toggle profile menu"
			class="w-full flex items-center justify-between gap-2.5 rounded-xl border border-zinc-800 bg-zinc-900/60 p-2.5 hover:bg-zinc-800/80 transition text-left focus:outline-none cursor-pointer"
		>
			<div class="flex items-center gap-2.5 min-w-0">
				<div class="h-8 w-8 overflow-hidden rounded-lg bg-zinc-800 flex items-center justify-center font-mono text-xs font-bold text-white shrink-0">
					{user?.avatarUrl ? (
						<img src={user.avatarUrl} alt={user.name} class="h-full w-full object-cover" />
					) : (
						user?.name?.charAt(0) || 'U'
					)}
				</div>
				<div class="min-w-0 flex-1">
					<p class="text-xs font-semibold text-white truncate">{user?.name || 'Astro Developer'}</p>
					<p class="text-[10px] text-zinc-400 font-mono truncate">{user?.role?.toUpperCase() || 'ADMIN'}</p>
				</div>
			</div>

			<svg class="w-4 h-4 text-zinc-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l4-4 4 4m0 6l-4 4-4-4"/>
			</svg>
		</button>
	</div>
</aside>

{/* MOBILE TOP APP HEADER (md:hidden) */}
<header class="md:hidden sticky top-0 z-40 border-b border-zinc-800 bg-zinc-950/95 backdrop-blur-md px-4 py-2.5">
	<div class="flex items-center justify-between">
		<div class="flex items-center gap-2">
			{isSubRoute ? (
				<a
					href="/app/overview"
					aria-label="Back to Webapp Hub"
					class="flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-900 text-zinc-300 hover:text-white transition"
				>
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
					</svg>
				</a>
			) : (
				<a href="/" class="flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-100 font-mono text-xs font-bold text-zinc-950">
					v7
				</a>
			)}

			<span class="text-sm font-semibold text-white tracking-tight">Webapp Shell</span>
		</div>

		{/* Mobile Right Controls: Search Icon Button & Header Profile Avatar Button */}
		<div class="flex items-center gap-2">
			<a
				href="/app/search"
				aria-label="Search"
				class={
					isSearchPage
						? 'flex h-8 w-8 items-center justify-center rounded-lg bg-zinc-800 text-white border border-zinc-700 transition'
						: 'flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-900 text-zinc-400 hover:text-white transition'
				}
			>
				<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
				</svg>
			</a>

			{/* Mobile Header Profile Avatar Button */}
			<a
				href="/app/profile"
				aria-label="User Profile"
				class={
					isProfilePage
						? 'flex h-8 w-8 items-center justify-center rounded-lg border-2 border-emerald-500 bg-zinc-800 overflow-hidden transition'
						: 'flex h-8 w-8 items-center justify-center rounded-lg border border-zinc-800 bg-zinc-900 overflow-hidden hover:border-zinc-700 transition'
				}
			>
				{user?.avatarUrl ? (
					<img src={user.avatarUrl} alt={user.name} class="h-full w-full object-cover" />
				) : (
					<svg class="w-4 h-4 text-zinc-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
					</svg>
				)}
			</a>
		</div>
	</div>
</header>

{/* MOBILE FIXED BOTTOM NAVIGATION BAR / TAB BAR (md:hidden - Streamlined 3 Columns) */}
<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 border-t border-zinc-800 bg-zinc-950/95 backdrop-blur-lg px-4 py-1.5 pb-[calc(0.5rem+env(safe-area-inset-bottom))] shadow-xl">
	<div class="grid grid-cols-3 gap-2 max-w-md mx-auto">
		{
			mobileBottomNavItems.map((item) => {
				const active = isItemActive(item);
				return (
					<a
						href={item.href}
						class={
							active
								? 'flex flex-col items-center justify-center py-1.5 px-2 rounded-lg bg-zinc-800 text-white font-medium transition'
								: 'flex flex-col items-center justify-center py-1.5 px-2 rounded-lg text-zinc-400 hover:text-zinc-200 transition'
						}
					>
						<Fragment set:html={item.icon} />
						<span class="text-[10px] mt-1 tracking-tight truncate w-full text-center">{item.shortLabel}</span>
					</a>
				);
			})
		}
	</div>
</nav>

<script is:inline>
	function setupAppNavInteractions() {
		const menuBtn = document.getElementById('mobile-menu-btn');
		const mobileMenu = document.getElementById('mobile-menu');
		const iconOpen = document.getElementById('menu-icon-open');
		const iconClose = document.getElementById('menu-icon-close');

		if (menuBtn && mobileMenu) {
			menuBtn.onclick = () => {
				const isOpen = mobileMenu.classList.contains('hidden');
				if (isOpen) {
					mobileMenu.classList.remove('hidden');
					iconOpen?.classList.add('hidden');
					iconClose?.classList.remove('hidden');
				} else {
					mobileMenu.classList.add('hidden');
					iconOpen?.classList.remove('hidden');
					iconClose?.classList.add('hidden');
				}
			};
		}

		// Desktop Interactive Profile Dropdown Popover Menu
		const profileBtn = document.getElementById('profile-dropdown-btn');
		const profileMenu = document.getElementById('profile-dropdown-menu');

		if (profileBtn && profileMenu) {
			profileBtn.onclick = (e) => {
				e.stopPropagation();
				profileMenu.classList.toggle('hidden');
			};

			document.onclick = (e) => {
				if (!profileMenu.contains(e.target) && !profileBtn.contains(e.target)) {
					profileMenu.classList.add('hidden');
				}
			};
		}
	}

	// Run initial setup
	setupAppNavInteractions();

	// Re-run setup on every Astro SPA View Transition page load!
	document.addEventListener('astro:page-load', setupAppNavInteractions);
</script>
