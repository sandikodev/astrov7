---
/**
 * Clean developer architectural pattern note card with syntax highlighting.
 * Props: number, title, description, code (optional snippet)
 */
import { highlightCode } from '@lib/syntaxHighlight';

interface Props {
	number: number;
	title: string;
	description: string;
	code?: string;
}

const { number, title, description, code } = Astro.props;
const formattedCode = code ? code.trim() : '';
const highlightedHtml = formattedCode ? highlightCode(formattedCode, 'ts') : '';
---

<div class="rounded-xl border border-zinc-800 bg-zinc-900/40 p-4 sm:p-5">
	<div class="flex items-start gap-3">
		<span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-zinc-700 bg-zinc-800 font-mono text-xs font-semibold text-zinc-300">
			{number}
		</span>
		<div class="flex-1 min-w-0">
			<h3 class="text-sm font-semibold text-zinc-200 truncate">{title}</h3>
			<p class="mt-1 text-xs sm:text-sm text-zinc-400 leading-relaxed">{description}</p>
			{
				formattedCode && (
					<div class="mt-3 max-w-full rounded-lg border border-zinc-800 bg-zinc-950 p-3 text-xs font-mono text-zinc-300 overflow-x-auto">
						<pre class="m-0 p-0 bg-transparent text-left font-mono whitespace-pre"><code set:html={highlightedHtml} /></pre>
					</div>
				)
			}
		</div>
	</div>
</div>