---
// Webapp Layout — Fixed Viewport Desktop App Shell + Native Mobile Layout — Composes BaseLayout
import BaseLayout from '@layouts/BaseLayout.astro';
import AppNav from '@components/AppNav.astro';

interface Props {
	title: string;
	description?: string;
	live?: boolean;
}

const {
	title,
	description = 'Astro v7 webapp simulation',
	live = true,
} = Astro.props;
---

<BaseLayout title={title} description={description} bodyClass="bg-zinc-950 text-zinc-100 selection:bg-zinc-800 selection:text-white antialiased min-h-screen md:h-screen md:max-h-screen md:overflow-hidden flex flex-col">
	{/* Main Workspace Area (AppNav Sidebar + Main Workspace Scroll Area) */}
	<div class="flex flex-1 flex-col md:flex-row min-h-0 md:overflow-hidden w-full">
		{/* Webapp Navigation */}
		<AppNav />

		{/* Inner Scrollable Workspace Area */}
		<div id="app-workspace-scroll" class="flex-1 overflow-y-auto w-full pt-0 flex flex-col min-h-0">
			<div class="flex-1">
				{/* Zero-Flicker Full-Width Sticky Header Banner */}
				<header
					id="app-sticky-header"
					class="sticky top-0 z-30 w-full px-4 sm:px-6 py-3 mb-6 border-b border-zinc-800/80 bg-zinc-950/95 backdrop-blur-md transition-all duration-200"
				>
					<div class="w-full flex items-center justify-between gap-3 min-w-0">
						<div class="min-w-0 flex-1">
							<h1 id="header-title" class="text-lg sm:text-xl font-bold tracking-tight text-white transition-all duration-200 truncate">
								{title}
							</h1>
							<p id="header-desc" class="mt-0.5 text-xs sm:text-sm text-zinc-400 transition-all duration-200 truncate">
								{description}
							</p>
						</div>

						{live && (
							<span id="header-badge" class="inline-flex shrink-0 items-center gap-1.5 rounded-md border border-zinc-800 bg-zinc-900 px-2.5 py-1 text-xs font-mono text-zinc-400 self-center">
								<span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
								prerender = false
							</span>
						)}
					</div>
				</header>

				<main class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
					<slot />
				</main>
			</div>

			{/* Compact Webapp Workspace Micro-Footer (Spans corner-to-corner full width) */}
			<footer class="mt-auto border-t border-zinc-800/60 bg-zinc-950/90 py-2.5 px-4 sm:px-6 text-[11px] text-zinc-500 shrink-0">
				<div class="w-full flex flex-col sm:flex-row items-center justify-between gap-2">
					<p class="font-mono text-zinc-400">astrov7 · Native Webapp Shell</p>
					<p>On-demand Cloudflare Workers SSR + Neon Serverless Postgres</p>
				</div>
			</footer>
		</div>
	</div>

	<script is:inline>
		function setupStickyHeader() {
			const scrollContainer = document.getElementById('app-workspace-scroll');
			const header = document.getElementById('app-sticky-header');
			const title = document.getElementById('header-title');
			const desc = document.getElementById('header-desc');

			if (!scrollContainer || !header || !title) return;

			let isMinimized = false;

			const onScroll = () => {
				const st = scrollContainer.scrollTop;

				if (!isMinimized && st > 30) {
					isMinimized = true;
					header.classList.add('shadow-md', 'border-zinc-800');
					title.classList.add('text-sm', 'font-semibold');
					title.classList.remove('text-lg', 'sm:text-xl', 'font-bold');
					if (desc) {
						desc.classList.add('hidden');
					}
				} 
				else if (isMinimized && st < 8) {
					isMinimized = false;
					header.classList.remove('shadow-md');
					title.classList.remove('text-sm', 'font-semibold');
					title.classList.add('text-lg', 'sm:text-xl', 'font-bold');
					if (desc) {
						desc.classList.remove('hidden');
					}
				}
			};

			scrollContainer.removeEventListener('scroll', onScroll);
			scrollContainer.addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		}

		setupStickyHeader();
		document.addEventListener('astro:page-load', setupStickyHeader);
	</script>
</BaseLayout>