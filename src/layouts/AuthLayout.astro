---
// Dedicated Clean Auth Layout — Composes BaseLayout
import BaseLayout from '@layouts/BaseLayout.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Sign in or register for AstroJS v7 Webapp' } = Astro.props;
---

<BaseLayout title={title} description={description} bodyClass="h-dvh flex flex-col bg-zinc-950 text-zinc-100 selection:bg-indigo-500/40 selection:text-white antialiased font-sans overflow-hidden" htmlClass="dark h-full">
	{/* Ambient Background Aura Glow */}
	<div class="fixed inset-0 pointer-events-none z-0">
		<div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1000px] h-[500px] bg-gradient-to-b from-indigo-500/10 via-purple-500/5 to-transparent blur-3xl rounded-full opacity-60"></div>
		<div class="absolute inset-0 bg-[linear-gradient(to_right,#27272a15_1px,transparent_1px),linear-gradient(to_bottom,#27272a15_1px,transparent_1px)] bg-[size:4rem_4rem]"></div>
	</div>

	{/* Full Viewport Canvas with Dynamic Auto-Centering */}
	<div class="relative z-10 flex flex-1 min-h-0 w-full flex-col justify-between overflow-y-auto">
		{/* Corner-to-Corner Micro Header Bar */}
		<header class="flex items-center justify-between w-full shrink-0 px-4 sm:px-6 py-2.5 sm:py-3">
			<a href="/" class="group flex items-center gap-2.5 transition">
				<div class="flex h-7 w-7 items-center justify-center rounded-lg bg-zinc-100 text-zinc-950 font-mono text-xs font-bold shadow-md shadow-zinc-100/10 group-hover:scale-105 transition-transform">
					v7
				</div>
				<span class="text-xs sm:text-sm font-semibold tracking-tight text-white group-hover:text-zinc-200">AstroJS v7</span>
			</a>

			<a
				href="/"
				class="inline-flex items-center gap-1.5 rounded-full border border-zinc-800/80 bg-zinc-900/60 px-3 py-1 text-xs font-medium text-zinc-400 hover:border-zinc-700 hover:bg-zinc-800 hover:text-white backdrop-blur-md transition shadow-sm"
			>
				<svg class="w-3 h-3 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
				</svg>
				<span>Back to Website</span>
			</a>
		</header>

		{/* Center Content Slot with Dynamic Vertical Fit */}
		<main class="my-auto w-full max-w-md mx-auto px-4 py-3 sm:py-4 flex flex-col justify-center shrink-0">
			<slot />
		</main>

		{/* Micro Bottom Footer */}
		<footer class="w-full text-center shrink-0 py-2 px-4 bg-zinc-950/80 border-t border-zinc-800/80">
			<p class="text-[11px] font-mono text-zinc-500">
				© 2026 AstroJS v7 Webapp Shell · Protected by Neon Auth & Middleware
			</p>
		</footer>
	</div>
</BaseLayout>
