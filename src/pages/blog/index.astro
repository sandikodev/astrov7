---
// Static listing page — posts generated at build time via content collections.
import Layout from '@/layouts/Layout.astro';
import PatternNote from '@/components/PatternNote.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Blog — Astro v7 simulation" description="Simulation notes on Astro 7 rendering, fetching, and caching.">
	<header class="mb-10 text-left">
		<div class="inline-flex items-center gap-2 rounded-full border border-indigo-500/30 bg-indigo-500/10 px-3 py-1 text-xs font-semibold font-mono text-indigo-300 mb-4">
			Content Collections
		</div>
		<h1 class="text-3xl sm:text-4xl font-extrabold text-white">Blog & Architecture Notes</h1>
		<p class="mt-3 max-w-2xl text-base text-zinc-400 leading-relaxed">
			These posts are Markdown files in <code class="rounded bg-zinc-800 px-1.5 py-0.5 font-mono text-xs text-indigo-300">src/content/blog</code>,
			typed and validated by the Content Layer API, and serialized to static HTML at build time.
		</p>
	</header>

	<div class="grid gap-5">
		{
			posts.map((post) => (
				<a
					href={`/blog/${post.id}`}
					class="group block rounded-2xl border border-zinc-800 bg-zinc-900/60 p-6 sm:p-7 backdrop-blur-sm transition hover:border-indigo-500/60 hover:shadow-xl hover:shadow-indigo-500/5"
				>
					<div class="flex flex-wrap items-center gap-2.5 text-xs text-zinc-500">
						<time datetime={post.data.pubDate.toISOString()} class="font-mono text-zinc-400">
							{post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
						</time>
						<span class="text-zinc-700">•</span>
						{post.data.tags.map((tag) => (
							<span class="rounded-md bg-zinc-800/80 px-2 py-0.5 font-mono text-[11px] text-zinc-300">#{tag}</span>
						))}
					</div>

					<h2 class="mt-3 text-xl font-bold text-white group-hover:text-indigo-300 transition-colors">
						{post.data.title}
					</h2>
					<p class="mt-2 text-sm leading-relaxed text-zinc-400">{post.data.description}</p>
					
					<div class="mt-4 flex items-center text-xs font-semibold text-indigo-400 group-hover:translate-x-1 transition-transform">
						Read article →
					</div>
				</a>
			))
		}
	</div>

	<div class="mt-12">
		<PatternNote
			number={1}
			title="getStaticPaths + getCollection"
			description="Each '/blog/[slug]' page is generated once at build time. No server, no JavaScript on the client."
			code={`const posts = await getCollection('blog');\nexport async function getStaticPaths() {\n  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));\n}`}
		/>
	</div>
</Layout>