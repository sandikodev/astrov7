---
// Static dynamic route — one HTML file per post, generated at build time.
import Layout from '@layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
	title={`${post.data.title} — Blog`}
	description={post.data.description}
>
	<article class="mx-auto max-w-3xl">
		<a
			href="/blog"
			class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition"
		>
			<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
			</svg>
			Back to Blog
		</a>

		<header class="mt-6 border-b border-zinc-800/80 pb-8">
			<div class="flex flex-wrap items-center gap-2.5 text-xs text-zinc-500">
				<time datetime={post.data.pubDate.toISOString()} class="font-mono text-zinc-400">
					{post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long' })}
				</time>
				<span class="text-zinc-700">•</span>
				{post.data.tags.map((tag) => (
					<span class="rounded-md bg-zinc-800/80 px-2.5 py-0.5 font-mono text-[11px] text-zinc-300">#{tag}</span>
				))}
			</div>

			<h1 class="mt-4 text-3xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
				{post.data.title}
			</h1>
			<p class="mt-4 text-base sm:text-lg text-zinc-300 leading-relaxed">{post.data.description}</p>
		</header>

		<div class="prose-demo mt-8">
			<Content />
		</div>
	</article>
</Layout>