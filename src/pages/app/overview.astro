---
// Webapp hub — on-demand dynamic dashboard streaming from Cloudflare Worker.
export const prerender = false;
import AppLayout from '@layouts/AppLayout.astro';

const now = new Date().toISOString();
---

<AppLayout title="Webapp Overview" description="Native App Shell & Module Dashboard" live>
	{/* Top Stats Banner */}
	<div class="mb-6 rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 font-mono text-xs text-zinc-300 overflow-hidden">
		<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
			<div class="flex items-center gap-2 text-zinc-200 font-semibold truncate min-w-0">
				<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-emerald-400"></span>
				<span class="truncate">Worker Runtime Status: Active</span>
			</div>
			<div class="text-[11px] text-zinc-400 whitespace-nowrap shrink-0">
				Rendered at <span class="text-zinc-200 font-mono">{now}</span>
			</div>
		</div>
		<p class="mt-2.5 text-zinc-400 text-xs font-sans leading-relaxed truncate">
			Select a module below to test different data-fetching & database integration patterns.
		</p>
	</div>

	{/* Modules Grid */}
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-2">
		{/* Neon Data API Module Card */}
		<a
			href="/app/neon-api"
			class="group flex flex-col justify-between rounded-xl border border-indigo-500/30 bg-indigo-500/10 p-5 transition hover:border-indigo-500/60 hover:bg-indigo-500/20"
		>
			<div>
				<div class="flex items-center justify-between">
					<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-500/20 text-indigo-300 border border-indigo-500/40 shrink-0">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
						</svg>
					</div>
					<span class="shrink-0 rounded bg-indigo-500/20 border border-indigo-500/30 px-2 py-0.5 font-mono text-[10px] text-indigo-300">
						Serverless HTTP API
					</span>
				</div>
				<h2 class="mt-3.5 text-base font-semibold text-white group-hover:text-indigo-200 transition truncate">Neon Data API</h2>
				<p class="mt-1.5 text-xs text-zinc-300 leading-relaxed">
					Interactive simulation of 5 core architectural use cases: Edge query, atomic transactions, webhooks, RLS & branching.
				</p>
			</div>
			<div class="mt-5 flex items-center justify-between pt-3 border-t border-indigo-500/20 text-xs font-medium text-indigo-300 group-hover:text-white transition">
				<span class="truncate">Open Data API Showcase</span>
				<span class="group-hover:translate-x-1 transition shrink-0">→</span>
			</div>
		</a>

		{/* Weather Module Card */}
		<a
			href="/app/weather"
			class="group flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 transition hover:border-zinc-700 hover:bg-zinc-900/60"
		>
			<div>
				<div class="flex items-center justify-between">
					<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-800 text-zinc-300 border border-zinc-700/80 shrink-0">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
						</svg>
					</div>
					<span class="shrink-0 rounded bg-zinc-800 px-2 py-0.5 font-mono text-[10px] text-zinc-300">
						SSR + Cache
					</span>
				</div>
				<h2 class="mt-3.5 text-base font-semibold text-white group-hover:text-zinc-200 transition truncate">Weather</h2>
				<p class="mt-1.5 text-xs text-zinc-400 leading-relaxed">
					Server-side upstream fetch + Cloudflare route caching + server island component.
				</p>
			</div>
			<div class="mt-5 flex items-center justify-between pt-3 border-t border-zinc-800/60 text-xs font-medium text-zinc-400 group-hover:text-white transition">
				<span class="truncate">Open module</span>
				<span class="group-hover:translate-x-1 transition shrink-0">→</span>
			</div>
		</a>

		{/* Todos Module Card */}
		<a
			href="/app/todos"
			class="group flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 transition hover:border-zinc-700 hover:bg-zinc-900/60"
		>
			<div>
				<div class="flex items-center justify-between">
					<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-800 text-zinc-300 border border-zinc-700/80 shrink-0">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
						</svg>
					</div>
					<span class="shrink-0 rounded bg-zinc-800 px-2 py-0.5 font-mono text-[10px] text-zinc-300">
						KV Sessions
					</span>
				</div>
				<h2 class="mt-3.5 text-base font-semibold text-white group-hover:text-zinc-200 transition truncate">Todos</h2>
				<p class="mt-1.5 text-xs text-zinc-400 leading-relaxed">
					<code class="text-zinc-200 font-mono">astro:actions</code> mutations + per-user encrypted session storage in Cloudflare KV.
				</p>
			</div>
			<div class="mt-5 flex items-center justify-between pt-3 border-t border-zinc-800/60 text-xs font-medium text-zinc-400 group-hover:text-white transition">
				<span class="truncate">Open module</span>
				<span class="group-hover:translate-x-1 transition shrink-0">→</span>
			</div>
		</a>

		{/* Search Module Card */}
		<a
			href="/app/search"
			class="group flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 transition hover:border-zinc-700 hover:bg-zinc-900/60"
		>
			<div>
				<div class="flex items-center justify-between">
					<div class="flex h-9 w-9 items-center justify-center rounded-lg bg-zinc-800 text-zinc-300 border border-zinc-700/80 shrink-0">
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
						</svg>
					</div>
					<span class="shrink-0 rounded bg-zinc-800 px-2 py-0.5 font-mono text-[10px] text-zinc-300">
						Preact + CDN
					</span>
				</div>
				<h2 class="mt-3.5 text-base font-semibold text-white group-hover:text-zinc-200 transition truncate">Search</h2>
				<p class="mt-1.5 text-xs text-zinc-400 leading-relaxed">
					Debounced Preact client island calling a route-cached API endpoint with tag invalidation.
				</p>
			</div>
			<div class="mt-5 flex items-center justify-between pt-3 border-t border-zinc-800/60 text-xs font-medium text-zinc-400 group-hover:text-white transition">
				<span class="truncate">Open module</span>
				<span class="group-hover:translate-x-1 transition shrink-0">→</span>
			</div>
		</a>
	</div>
</AppLayout>