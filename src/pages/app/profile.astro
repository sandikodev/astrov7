---
// Webapp Profile Route — User Details, Native Shortcuts & Avatar Storage in Neon Object Storage
export const prerender = false;
import AppLayout from '@layouts/AppLayout.astro';
import ProfileEditor from '@components/ProfileEditor';
import { getUserProfiles, type UserProfile } from '@lib/neon';

const profiles = await getUserProfiles();
const fallbackProfile: UserProfile = {
	id: 'usr_dev_01',
	email: 'dev@astrov7.community',
	name: 'Astro Developer',
	avatarUrl: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80',
	role: 'admin',
	department: 'Engineering',
	maxStorageMb: 1024,
	createdAt: new Date().toISOString(),
};
const currentProfile: UserProfile = profiles[0] || fallbackProfile;
---

<AppLayout title="User Profile" description="Neon Object Storage & Postgres Profile Management" live>
	<div class="space-y-8">
		<ProfileEditor client:load initialProfile={currentProfile} />

		{/* Native Mobile Action List / Shortcuts (Appears on Mobile & Tablet for Native Feel) */}
		<div class="md:hidden space-y-3 pt-6 border-t border-zinc-800/80">
			<h3 class="px-1 text-xs font-semibold text-zinc-400 font-mono uppercase tracking-wider">Quick Actions</h3>
			
			<div class="rounded-2xl border border-zinc-800 bg-zinc-900/60 divide-y divide-zinc-800/80 overflow-hidden">
				<a
					href="/app/settings"
					class="flex items-center justify-between p-4 text-xs font-medium text-white hover:bg-zinc-800/60 transition"
				>
					<div class="flex items-center gap-3">
						<div class="flex h-8 w-8 items-center justify-center rounded-xl bg-zinc-800 text-zinc-300">
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
							</svg>
						</div>
						<span>Pengaturan App (RBAC / ABAC)</span>
					</div>
					<svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
					</svg>
				</a>

				<a
					href="/"
					class="flex items-center justify-between p-4 text-xs font-medium text-white hover:bg-zinc-800/60 transition"
				>
					<div class="flex items-center gap-3">
						<div class="flex h-8 w-8 items-center justify-center rounded-xl bg-zinc-800 text-zinc-300">
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 00-1-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
							</svg>
						</div>
						<span>Kembali ke Website Utama</span>
					</div>
					<svg class="w-4 h-4 text-zinc-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
					</svg>
				</a>

				<a
					href="/api/auth/signout"
					class="flex items-center justify-between p-4 text-xs font-medium text-rose-400 hover:bg-rose-500/10 transition"
				>
					<div class="flex items-center gap-3">
						<div class="flex h-8 w-8 items-center justify-center rounded-xl bg-rose-500/10 text-rose-400 border border-rose-500/20">
							<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
							</svg>
						</div>
						<span>Keluar / Sign Out</span>
					</div>
					<svg class="w-4 h-4 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
					</svg>
				</a>
			</div>
		</div>
	</div>
</AppLayout>
