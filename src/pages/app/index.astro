---
// Webapp Entry Splash — branded loader that redirects the user to the app hub (/app/overview) after a few seconds.
export const prerender = false;
import '@/styles/global.css';

const target = '/app/overview';
const delay = 3200;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Astro v7 webapp simulation — launching workspace" />
		<meta name="color-scheme" content="dark" />
		<meta name="robots" content="noindex" />
		<meta http-equiv="refresh" content={`${Math.round(delay / 1000)}; url=${target}`} />
		<title>Webapp — Launching</title>
	</head>
	<body class="bg-zinc-950 text-zinc-100 selection:bg-zinc-800 selection:text-white antialiased min-h-screen flex items-center justify-center px-6">
		<main class="flex w-full max-w-sm flex-col items-center text-center">
			{/* Brand Mark */}
			<div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-zinc-100 font-mono text-lg font-bold text-zinc-950 shadow-[0_0_40px_rgba(255,255,255,0.08)]">
				v7
			</div>

			<h1 class="mt-6 text-lg font-semibold tracking-tight text-white">Webapp Shell</h1>
			<p class="mt-1 text-xs text-zinc-400 font-mono">Cloudflare Workers Runtime</p>

			{/* Loader + redirect */}
			<div class="mt-10 flex w-full flex-col items-center gap-3">
				<div
					class="h-1 w-40 overflow-hidden rounded-full bg-zinc-800"
					role="progressbar"
					aria-label="Launching webapp"
				>
					<div id="fill" class="h-full w-0 rounded-full bg-emerald-400 transition-[width]"></div>
				</div>
				<p class="font-mono text-[11px] text-zinc-500">
					Launching modules<span id="dots">…</span>
				</p>
			</div>

			<a
				href={target}
				class="mt-8 inline-flex items-center gap-1.5 rounded-lg border border-zinc-800 bg-zinc-900 px-3 py-1.5 text-xs font-medium text-zinc-300 hover:bg-zinc-800 hover:text-white transition"
			>
				Open Overview
				<svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 12h14"/>
				</svg>
			</a>
		</main>

		<script is:inline>
			const target = '/app/overview';
			const delay = 3200;
			const fill = document.getElementById('fill');
			const dots = document.getElementById('dots');

			fill.style.width = '100%';
			fill.style.transitionDuration = delay + 'ms';

			// Animated ellipsis while loading
			let tick = 0;
			const anim = window.setInterval(() => {
				tick = (tick + 1) % 4;
				dots.textContent = '…'.slice(0, tick + 1);
			}, 400);

			window.setTimeout(() => {
				window.clearInterval(anim);
				window.location.replace(target);
			}, delay);
		</script>
	</body>
</html>