---
// On-demand page: fetch upstream server-side, stream result, cache the page.
export const prerender = false;
import AppLayout from '@layouts/AppLayout.astro';
import CacheInfo from '@components/CacheInfo.astro';
import PatternNote from '@components/PatternNote.astro';
import LiveStats from '@components/LiveStats.astro';
import { fetchJsonWithTimeout } from '@lib/http';

interface OpenMeteoResponse {
	current?: {
		temperature_2m?: number;
		relative_humidity_2m?: number;
		wind_speed_10m?: number;
		time?: string;
	};
	current_units?: {
		temperature_2m?: string;
		relative_humidity_2m?: string;
		wind_speed_10m?: string;
	};
}

const CITY = { name: 'Jakarta', lat: -6.2088, lon: 106.8456 };
const url =
	`https://api.open-meteo.com/v1/forecast?latitude=${CITY.lat}&longitude=${CITY.lon}` +
	`&current=temperature_2m,relative_humidity_2m,wind_speed_10m&timezone=auto&forecast_days=1`;

const result = await fetchJsonWithTimeout<OpenMeteoResponse>(url, { timeoutMs: 8000 });

Astro.cache.set({ maxAge: 600, swr: 1800, tags: ['weather'] });
const now = new Date().toISOString();
---

<AppLayout title="Weather Module" description="Server-side on-demand fetch + route caching + server island" live>
	<p class="mb-6 text-xs sm:text-sm text-zinc-400 leading-relaxed">
		This page executed <code class="rounded bg-zinc-900 px-1.5 py-0.5 font-mono text-xs text-zinc-200">await fetch()</code> on the Cloudflare Worker at <code class="text-zinc-200 font-mono">{now}</code>, then streamed HTML directly.
	</p>

	<div class="grid gap-5 md:grid-cols-2 items-stretch">
		{/* Weather Card */}
		<section class="flex flex-col justify-between rounded-xl border border-zinc-800 bg-zinc-900/50 p-5 sm:p-6 h-full min-h-[200px]">
			<div>
				<div class="flex items-center justify-between">
					<h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-400 font-mono">
						{CITY.name} — Current Weather
					</h2>
					<span class="rounded bg-zinc-800 px-2 py-0.5 font-mono text-[10px] text-zinc-300">
						Live API
					</span>
				</div>

				{
					result.ok ? (
						<div class="mt-4">
							<div class="flex items-baseline gap-1.5">
								<span class="text-4xl sm:text-5xl font-bold tracking-tight text-white">
									{result.data.current?.temperature_2m ?? '—'}
								</span>
								<span class="text-lg font-semibold text-zinc-400">
									{result.data.current_units?.temperature_2m ?? '°C'}
								</span>
							</div>

							<dl class="mt-5 grid grid-cols-2 gap-4 rounded-lg bg-zinc-950 p-3.5 border border-zinc-800/80 text-xs">
								<div>
									<dt class="text-zinc-500 uppercase font-mono">Humidity</dt>
									<dd class="mt-1 text-base font-semibold text-white">
										{result.data.current?.relative_humidity_2m ?? '—'}
										<span class="text-xs font-normal text-zinc-400">{result.data.current_units?.relative_humidity_2m ?? '%'}</span>
									</dd>
								</div>
								<div>
									<dt class="text-zinc-500 uppercase font-mono">Wind Speed</dt>
									<dd class="mt-1 text-base font-semibold text-white">
										{result.data.current?.wind_speed_10m ?? '—'}
										<span class="text-xs font-normal text-zinc-400">{result.data.current_units?.wind_speed_10m ?? 'km/h'}</span>
									</dd>
								</div>
							</dl>
						</div>
					) : (
						<div class="mt-4">
							<p class="rounded-lg border border-red-500/30 bg-red-500/10 px-3.5 py-2.5 text-xs text-red-300">
								{result.error}
							</p>
						</div>
					)
				}
			</div>

			{
				result.ok && result.data.current?.time && (
					<p class="mt-4 text-[11px] text-zinc-500 font-mono pt-3 border-t border-zinc-800/80">Observed: {result.data.current.time}</p>
				)
			}
		</section>

		{/* Server Island Section */}
		<div class="h-full">
			<LiveStats server:defer>
				<div
					slot="fallback"
					class="flex h-full min-h-[200px] animate-pulse items-center justify-center rounded-xl border border-zinc-800 bg-zinc-900/40 p-5 sm:p-6 font-mono text-xs text-zinc-500"
				>
					loading server island…
				</div>
			</LiveStats>
		</div>
	</div>

	<CacheInfo status="Cloudflare-CDN-Cache-Control" maxAge={600} swr={1800} tags={['weather']} />

	<div class="mt-8 space-y-3">
		<PatternNote
			number={1}
			title="Server-side fetch, streamed to the client"
			description="The upstream call happens in frontmatter. Astro 7 streams rendered HTML as it's ready — no client fetch logic required."
			code={`const result = await fetchJsonWithTimeout<OpenMeteoResponse>(url);\nAstro.cache.set({ maxAge: 600, swr: 1800, tags: ['weather'] });`}
		/>
		<PatternNote
			number={2}
			title="Page-level route caching"
			description="cache.set() emits CDN headers, so this HTML page is served from Cloudflare's edge cache for 10 minutes."
			code={`Astro.cache.set({ maxAge: 600, swr: 1800, tags: ['weather'] });`}
		/>
	</div>
</AppLayout>