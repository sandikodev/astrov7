---
// Custom 404 page — emitted as dist/client/404.html and served by Cloudflare
// Workers Assets when `not_found_handling: "404-page"` is set (wrangler.jsonc).
import Layout from '@/layouts/Layout.astro';
---

<Layout title="404 — Not found">
	<header class="py-16 text-center sm:py-24">
		<p class="font-mono text-xs uppercase tracking-widest text-indigo-400">HTTP 404</p>
		<h1 class="mt-4 text-5xl font-bold tracking-tight text-white sm:text-6xl">
			Route not rendered.
		</h1>
		<p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-zinc-400">
			The path you requested isn't part of this simulation — it was never prerendered
			into a file at build time.
		</p>
		<div class="mt-8 flex flex-wrap justify-center gap-3">
			<a
				href="/"
				class="rounded-md bg-white px-4 py-2 text-sm font-semibold text-zinc-900 hover:bg-zinc-200"
			>
				Back home
			</a>
			<a
				href="/app"
				class="rounded-md border border-zinc-700 px-4 py-2 text-sm font-semibold text-zinc-200 hover:bg-zinc-900"
			>
				Open the webapp →
			</a>
		</div>
	</header>

	<p class="mt-12 text-center text-xs text-zinc-500">
		Requested path: <code class="text-zinc-400">{Astro.url.pathname}</code> — served from
		<code class="text-zinc-400">dist/client/404.html</code>.
	</p>
</Layout>