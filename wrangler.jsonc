{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "astrov7",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"compatibility_date": "2026-08-30",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client",
		"not_found_handling": "404-page",
		"run_worker_first": ["/", "/app", "/app/*", "/api/*", "/auth", "/auth/*", "/_actions/*", "/_server-islands/*", "/_image"]
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "fc6773aceea2465d8e9d2669bbf9a4d6"
		}
	],
	"vars": {
		"PUBLIC_NEON_DATA_API_URL": "https://ep-billowing-math-aymuolsm.apirest.c-5.us-east-2.aws.neon.tech/neondb/rest/v1",
		"VITE_NEON_DATA_API_URL": "https://ep-billowing-math-aymuolsm.apirest.c-5.us-east-2.aws.neon.tech/neondb/rest/v1",
		"PUBLIC_NEON_AUTH_URL": "https://ep-billowing-math-aymuolsm.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth",
		"VITE_NEON_AUTH_URL": "https://ep-billowing-math-aymuolsm.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth",
		"NEON_AUTH_JWKS_URL": "https://ep-billowing-math-aymuolsm.neonauth.c-5.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json",
		"AWS_ENDPOINT_URL_S3": "https://br-summer-forest-ayvmtihb.storage.c-5.us-east-2.aws.neon.tech",
		"AWS_REGION": "us-east-2",
		"S3_BUCKET_NAME": "assets"
	},
	"observability": { "enabled": true }
}